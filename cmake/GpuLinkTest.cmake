# Optional, vendor-neutral renderer. All Vulkan calls occur in the test child.
option(GPU_LINK_TEST "Build the optional Vulkan GPU link activation test" ON)
if(NOT GPU_LINK_TEST)
    return()
endif()
find_path(GPU_LINK_VULKAN_INCLUDE_DIR vulkan/vulkan.h)
find_program(GPU_LINK_GLSLANG NAMES glslangValidator)
if(NOT GPU_LINK_VULKAN_INCLUDE_DIR OR NOT GPU_LINK_GLSLANG)
    message(STATUS "GPU link test: disabled (Vulkan headers or glslangValidator unavailable)")
    return()
endif()
include(CheckCXXSourceCompiles)
include(CMakePushCheckState)
cmake_push_check_state(RESET)
set(CMAKE_REQUIRED_LIBRARIES Qt6::Gui)
set(CMAKE_REQUIRED_INCLUDES ${GPU_LINK_VULKAN_INCLUDE_DIR})
check_cxx_source_compiles("#include <QVulkanWindow>
#include <vulkan/vulkan.h>
int main() { QVulkanWindow w; VkPhysicalDevicePCIBusInfoPropertiesEXT p{}; (void)p; }"
    GPU_LINK_QT_VULKAN)
cmake_pop_check_state()
if(NOT GPU_LINK_QT_VULKAN)
    message(STATUS "GPU link test: disabled (Vulkan headers, glslangValidator or Qt Vulkan support unavailable)")
    return()
endif()
set(GPU_LINK_SHADER "${CMAKE_CURRENT_SOURCE_DIR}/resources/embedded/gpulink/waves.glsl")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${GPU_LINK_SHADER}")
file(READ "${GPU_LINK_SHADER}" GPU_LINK_SHADER_SOURCE)
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated/gpulink")
configure_file(resources/embedded/gpulink/fragment.in generated/gpulink/workload.frag @ONLY)
foreach(stage IN ITEMS vert frag)
    if(stage STREQUAL "vert")
        set(shader_input "${CMAKE_CURRENT_SOURCE_DIR}/resources/embedded/gpulink/fullscreen.vert")
    else()
        set(shader_input "${CMAKE_CURRENT_BINARY_DIR}/generated/gpulink/workload.frag")
    endif()
    set(shader_output "${CMAKE_CURRENT_BINARY_DIR}/generated/gpulink/workload.${stage}.spv")
    add_custom_command(OUTPUT "${shader_output}"
        COMMAND "${GPU_LINK_GLSLANG}" -V --target-env vulkan1.1 -o "${shader_output}" "${shader_input}"
        DEPENDS "${shader_input}" VERBATIM)
    set_source_files_properties("${shader_output}" PROPERTIES GENERATED TRUE)
    set_source_files_properties("${shader_output}" PROPERTIES QT_RESOURCE_ALIAS "workload.${stage}.spv")
    list(APPEND gpu_link_spirv "${shader_output}")
endforeach()
qt_add_resources(qlinuxdevicemanager gpu_link_shaders PREFIX "/gpulink" FILES ${gpu_link_spirv})
target_sources(qlinuxdevicemanager PRIVATE src/ui/gpulinkrenderer.cpp)
target_include_directories(qlinuxdevicemanager PRIVATE ${GPU_LINK_VULKAN_INCLUDE_DIR})
target_compile_definitions(qlinuxdevicemanager PRIVATE QLDM_HAVE_GPU_LINK_TEST)
message(STATUS "GPU link test: enabled (Vulkan, loaded only by the test child)")
